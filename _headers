/*
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://openrouter.ai; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self' https://checkout.stripe.com; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Applagren måste alltid revalideras.
#
# Cloudflare Pages sätter annars max-age=14400 på statiska filer, och
# filnamnen är inte innehållshashade. En kund kan därför köra fyra timmar
# gammal kod efter en deploy — ovanpå service workerns egen cache, som
# redan gjort flera felsökningsrundor längre än de behövde vara.
#
# no-cache betyder inte "hämta alltid om", utan "fråga alltid först". Svaret
# blir 304 utan kropp när inget ändrats, alltså några hundra byte. Det är
# billigare än en enda felsökning av något som redan är rättat.
# Sälj- och juridiktexten måste också revalideras. Cloudflare Pages cachar
# HTML i fyra timmar som standard, och 2026-08-06 gjorde det att villkoren och
# integritetspolicyn visade en modell vi slutat använda medan prislistan redan
# var uppdaterad. Prislistan och avsnitt 4 i villkoren ska ändras samma dag —
# det löftet är värdelöst om ena sidan når kunden fyra timmar efter den andra.
/index.html
  Cache-Control: no-cache

/villkor.html
  Cache-Control: no-cache

/integritet.html
  Cache-Control: no-cache

/portal/app.js
  Cache-Control: no-cache

/portal/sw.js
  Cache-Control: no-cache

/portal/teams/*
  Cache-Control: no-cache

/builder/builder.js
  Cache-Control: no-cache

/atb-claude.js
  Cache-Control: no-cache

/avatars.js
  Cache-Control: no-cache

/verticals/app.js
  Cache-Control: no-cache

/site/gallery.js
  Cache-Control: no-cache

# CSS måste revalideras av samma skäl som JS, och glömdes bort när listan
# skrevs. Designsystemet delar tokennamn mellan tre filer (showcase.css,
# portal.css, builder.css) — hämtas två av dem färska och den tredje ur en
# fyra timmar gammal cache blir resultatet inte "gammal design" utan en
# blandning: halva sidan i nya färger, halva i gamla. Det ser ut som en bugg
# i designen i stället för som en cache.
/site/showcase.css
  Cache-Control: no-cache

/portal/portal.css
  Cache-Control: no-cache

/builder/builder.css
  Cache-Control: no-cache

/fonts/fonts.css
  Cache-Control: no-cache
