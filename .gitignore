# Bygg-output för Cloudflare Pages
/dist/

# Node
/node_modules/
npm-debug.log*

# Wrangler / Cloudflare
.wrangler/

# Käll-/arbetsbilder (avatar-crops klipps ur dessa; deployas aldrig)
/avatarer*.png

# Secrets (lokal dev av Cloudflare Functions / Stripe) — aldrig i git
.dev.vars
.dev.vars.*
.env
.env.*

# Provisionering: innehåller kunddata, hör hemma i databasen och inte i git
scripts/.provision.sql
scratch-*.json

# D1-exporter (npm run db:backup). Innehåller kunddata — konton, betald åtkomst,
# planstatus — och ska aldrig hamna i git. OBS: kopiorna skyddar därmed mot en
# trasig migration men INTE mot en trasig disk. Flytta dem någon annanstans.
/backup/
